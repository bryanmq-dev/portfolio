---
import '../styles/global.css';
interface Props {
  titulo: string;
  descripcion?: string;
  /** Ruta o URL de la imagen para compartir; por defecto /og.png. */
  imagen?: string;
  noindex?: boolean;
  /** Datos estructurados (schema.org) para Google. */
  jsonld?: object;
  body?: Record<string, string>;
}
const { titulo, descripcion = 'Portafolio de Bryan Iban Mamani Quispe (bryanmq-dev): desarrollador full-stack.', imagen = '/og.png', noindex = false, jsonld } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const img = new URL(imagen, Astro.site).href;
// JSON dentro de <script>: se escapa "<" para que un texto con "</script>" no cierre la etiqueta.
const ld = jsonld && JSON.stringify(jsonld).replace(/</g, '\\u003c');
const verificacion = process.env.GOOGLE_SITE_VERIFICATION;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="author" content="Bryan Iban Mamani Quispe" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonica} />}
    <meta name="theme-color" content="#f3f2ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080808" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bryanmq-dev" />
    <meta property="og:locale" content="es_BO" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={img} />
    {imagen === '/og.png' && <meta property="og:image:width" content="1200" />}
    {imagen === '/og.png' && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={titulo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={img} />
    {verificacion && <meta name="google-site-verification" content={verificacion} />}
    {ld && <script type="application/ld+json" set:html={ld} />}
    <!-- Antes de pintar: el tema guardado, para no parpadear. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('tema');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body {...Astro.props.body}>
    <slot />
  </body>
</html>
