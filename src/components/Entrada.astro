---
import { marked } from 'marked';
import { periodo, type Entrada } from '../contenido.ts';
interface Props {
  e: Entrada;
  oculta: boolean;
}
const { e, oculta } = Astro.props;
const esEvento = e.tipo === 'evento';
---

<article class="entrada" data-slug={e.slug} hidden={oculta} aria-labelledby={`t-${e.slug}`}>
  <h3 id={`t-${e.slug}`}>{e.titulo} {e.demo && <span class="demo-marca">DEMO</span>}</h3>
  <div class="meta">
    {e.inicio && <span>{periodo(e.inicio, e.fin)}</span>}
    {e.rol && <span>{esEvento ? 'Rol' : 'Cargo'}: <b>{e.rol}</b></span>}
    {e.cliente && <span>{esEvento ? 'Con' : e.tipo === 'experiencia' ? 'En' : 'Cliente'}: <b>{e.cliente}</b></span>}
    {e.enlace && <a href={e.enlace} target="_blank" rel="noopener">Ver ↗</a>}
  </div>
  <p class="prosa">{e.resumen}</p>
  {
    e.media.length > 0 && (
      <div class="galeria">
        {e.media.map((m) =>
          m.tipo === 'video' ? (
            <video src={m.url} controls playsinline preload="metadata" aria-label={m.alt} />
          ) : (
            <img src={m.url} alt={m.alt} loading="lazy" decoding="async" />
          )
        )}
      </div>
    )
  }
  {/* Solo el admin escribe este markdown. */}
  {e.cuerpo_md && <div class="prosa" set:html={marked.parse(e.cuerpo_md)} />}
  {
    e.tecnologias.length > 0 && (
      <div class="bloque">
        <h4>{esEvento ? 'Aliados' : 'Tecnologías'}</h4>
        <ul class="chips">
          {e.tecnologias.map((t) => (
            <li class="chip">{t}</li>
          ))}
        </ul>
      </div>
    )
  }
  {
    e.ia.length > 0 && (
      <div class="ia">
        <h4>Cómo usé IA aquí</h4>
        <ul>
          {e.ia.map((x) => (
            <li>
              <b>{x.herramienta}</b> — {x.uso}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</article>
